APP_NAME=ScholarTube Edu
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Hugging Face is the only AI provider in this edition.
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_INFERENCE_PROVIDER=auto
HF_MAX_TOKENS=1200
HF_TIMEOUT_SECONDS=120
HF_REDUCE_BATCH_SIZE=8

# Optional direct SQLAlchemy URL. If provided, it wins over DB_* variables.
DATABASE_URL=

# PostgreSQL access. Fill these when you send database access later.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_DATABASE=
DB_SSL_MODE=

# Local fallback when DB_* is empty.
SQLITE_PATH=./scholartube.db
