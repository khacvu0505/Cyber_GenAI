ENVIRONMENT=development
DATABASE_DRIVER=postgresql+psycopg
DATABASE_HOST=app-database.cluster-cngkmmm8803r.ap-northeast-2.rds.amazonaws.com
DATABASE_PORT=5432
DATABASE_NAME=app_db
DATABASE_USER=postgres
DATABASE_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string
CORS_ORIGINS=["http://app-alp-358666095.ap-northeast-2.elb.amazonaws.com"]

# Amazon S3. Create the private bucket before starting the API.
# Leave credentials blank when using an IAM role or the standard AWS credential chain.
S3_REGION=ap-northeast-2
S3_BUCKET=cyber-genai-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_USE_SSL=true

# OpenAI embeddings
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Required for embeddings; also enables generated RAG answers.
OPENAI_API_KEY=sk-your-openai-key
OPENAI_CHAT_MODEL=gpt-5-mini

SEED_DEMO_DATA=true
DEMO_PASSWORD=change-me
